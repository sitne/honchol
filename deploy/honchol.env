# Derived service settings for honchol (sourced by run_serve.sh / run_derive.sh
# AFTER /etc/honchol/env, so CLOUDFLARE_* variables are already visible here).
#
# Judge (used for two-stage search re-ranking): enabled only when
# CLOUDFLARE_ACCOUNT_ID is set. Without it the server still starts and search
# degrades to fail-open (raw candidate order).
if [ -n "${CLOUDFLARE_ACCOUNT_ID:-}" ]; then
  HONCHO_LITE_JUDGE_URL="https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/run/@cf/cloudflare/clef-flash"
  HONCHO_LITE_JUDGE_KIND=clef
  # Optional local fallback — any judgment shim speaking the plain-answers protocol
  # (plain {"answers":{...}} responses). Example:
  # HONCHO_LITE_JUDGE_FALLBACK_URL="http://127.0.0.1:8799/v1/systemone"
fi

# LLM defaults (OpenAI-compatible): base https://opencode.ai/zen/go/v1,
# model deepseek-v4.1-flash, API key read from $OPENCODE_GO_API_KEY.
# Override examples:
# HONCHO_LITE_LLM_BASE_URL="https://api.openai.com/v1"
# HONCHO_LITE_LLM_MODEL="gpt-5-mini"
# HONCHO_LITE_LLM_KEY_ENV="OPENAI_API_KEY"
# HONCHO_LITE_LLM_TIMEOUT_MS=90000
